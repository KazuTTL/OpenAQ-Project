# OpenAQ API Configuration
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_BASE_URL=https://api.openaq.org/v3
TARGET_COUNTRY_ISO=VN
DEFAULT_LIMIT=100

# MinIO / S3 Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=openaq-data-lake
S3_REGION=us-east-1
S3_USE_SSL=False

# Data Warehouse (PostgreSQL) Configuration
DWH_DB_HOST=localhost
DWH_DB_PORT=5432
DWH_DB_NAME=openaq_dw
DWH_DB_USER=postgres
DWH_DB_PASSWORD=postgres
DWH_DB_SCHEMA=public

# Apache Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW_WEBSERVER_PORT=8082
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Apache Superset Configuration
SUPERSET_SECRET_KEY=openaq_superset_secret_key_change_in_production
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
